# Copia este archivo a .env.local y completa los valores reales.
# .env.local NUNCA debe subirse a git (ya está en .gitignore).

# Supabase — Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión a Postgres — Project Settings > Database > Connection
# string > URI, reemplazando [YOUR-PASSWORD] por la contraseña de la base (no
# es la Service Role Key; si no la tenés, se resetea en esa misma página).
# La usa `npm run db:push` para aplicar supabase/migrations/ sin pasar por el
# SQL Editor. La app en sí no la necesita: sólo el script de migraciones.
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.tu-ref.supabase.co:5432/postgres

# Opcional: ruta al certificado de la CA de Supabase (Project Settings >
# Database > SSL configuration). Sin esto la conexión de db:push va cifrada
# igual, pero sin verificar el certificado del servidor.
# SUPABASE_DB_CA=./prod-ca-2021.crt

# Google Gemini — https://aistudio.google.com/apikey
# IMPORTANTE: revoca cualquier clave que hayas compartido en un chat, email,
# o cualquier canal de texto plano, y genera una nueva antes de usarla aquí.
GEMINI_API_KEY=

# Opcionales: hasta 4 claves de Gemini en total (principal + 3 de respaldo).
# Se usan en orden automáticamente si la anterior agota su cuota o falla.
# Cada clave del nivel gratuito tiene su propio tope diario, así que varias
# claves también multiplican el volumen real de uso, no solo dan respaldo.
# GEMINI_API_KEY_BACKUP_4, _5, etc. también funcionan si hace falta una más.
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_BACKUP_2=
GEMINI_API_KEY_BACKUP_3=

# Opcional: Groq (https://console.groq.com/keys), última instancia si todas
# las claves de Gemini fallan. Sin lectura visual de PDF, solo texto extraído.
GROQ_API_KEY=
# Opcional: Groq da de baja modelos sin aviso. Si el respaldo empieza a
# fallar con "model_not_found", elegí uno vigente de
# GET https://api.groq.com/openai/v1/models y ponelo acá.
GROQ_MODEL=

# Secreto del cron que reintenta los trabajos encolados cuando todos los
# proveedores de IA están saturados o sin cuota (ver /api/trabajos/procesar).
# Vercel lo manda solo como "Authorization: Bearer <valor>" en cada corrida del
# cron declarado en vercel.json. Un cron externo puede pasarlo como ?secreto=.
# En producción es OBLIGATORIO: sin él el endpoint queda cerrado, porque uno
# abierto permitiría que cualquiera gaste la cuota de IA.
CRON_SECRET=
