# Copia este archivo a .env.local y completa los valores reales.
# .env.local NUNCA debe subirse a git (ya está en .gitignore).

# Supabase — Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# IMPORTANTE: revoca cualquier clave que hayas compartido en un chat, email,
# o cualquier canal de texto plano, y genera una nueva antes de usarla aquí.
GEMINI_API_KEY=

# Opcional: clave de Gemini de respaldo, distinta a la principal. Se usa
# automáticamente si la principal agota su cuota o falla.
GEMINI_API_KEY_BACKUP=

# Opcional: Groq (https://console.groq.com/keys), última instancia si ambas
# claves de Gemini fallan. Sin lectura visual de PDF, solo texto extraído.
GROQ_API_KEY=
# Opcional: Groq da de baja modelos sin aviso. Si el respaldo empieza a
# fallar con "model_not_found", elegí uno vigente de
# GET https://api.groq.com/openai/v1/models y ponelo acá.
GROQ_MODEL=
