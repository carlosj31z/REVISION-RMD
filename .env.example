# Copia este archivo a .env.local y completa los valores reales.
# .env.local NUNCA debe subirse a git (ya está en .gitignore).

# Supabase — Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# IMPORTANTE: revoca cualquier clave que hayas compartido en un chat, email,
# o cualquier canal de texto plano, y genera una nueva antes de usarla aquí.
GEMINI_API_KEY=
